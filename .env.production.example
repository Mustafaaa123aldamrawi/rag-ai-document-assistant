# AV Intelligence Assistant - production cloud configuration template
# Copy real values into your hosting provider's secret settings. Never commit secrets.

AVIA_ENV=production
AVIA_AUTH_MODE=jwt

# Managed PostgreSQL (Supabase Postgres or another managed PostgreSQL)
AVIA_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres

# Explicit trusted web/admin origins. Never use * in production.
AVIA_CORS_ORIGINS=https://YOUR_ADMIN_OR_WEB_APP.example

# Supabase Auth JWT verification
AVIA_JWT_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
AVIA_JWT_ALGORITHMS=ES256,RS256
AVIA_JWT_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1
AVIA_JWT_AUDIENCE=authenticated

# Private project artifact storage (AWS S3 or another S3-compatible provider)
AVIA_STORAGE_MODE=s3
AVIA_STORAGE_BUCKET=YOUR_PRIVATE_BUCKET
AVIA_STORAGE_REGION=YOUR_REGION
AVIA_STORAGE_ENDPOINT=
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_KEY

# Supabase account deletion admin integration
AVIA_ACCOUNT_DELETE_PROVIDER=supabase
AVIA_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
AVIA_SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

# Public compliance/support pages
AVIA_SUPPORT_EMAIL=support@YOUR_DOMAIN.example
AVIA_PUBLIC_BASE_URL=https://YOUR_DEPLOYED_API.example

# AI services
HF_TOKEN=YOUR_HUGGINGFACE_TOKEN
TAVILY_API_KEY=YOUR_TAVILY_KEY

# Optional observability
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
