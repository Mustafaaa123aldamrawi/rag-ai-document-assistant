# AV Intelligence Assistant - production API example
AVIA_ENV=production

# Managed PostgreSQL connection string (Supabase/Render/Railway/Neon/etc.)
AVIA_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE

# Production authentication
AVIA_AUTH_MODE=jwt
AVIA_JWT_JWKS_URL=https://YOUR-AUTH-PROVIDER/.well-known/jwks.json
AVIA_JWT_ALGORITHMS=RS256,ES256
AVIA_JWT_AUDIENCE=
AVIA_JWT_ISSUER=

# Alternative to JWKS:
# AVIA_JWT_PUBLIC_KEY=
# AVIA_JWT_SECRET=

# Explicit web origins only. Never use * in production.
AVIA_CORS_ORIGINS=https://admin.example.com

# Private artifact storage for drawings and generated reports.
AVIA_STORAGE_MODE=s3
AVIA_STORAGE_BUCKET=avia-production
AVIA_STORAGE_REGION=
# Optional for S3-compatible providers such as Cloudflare R2:
AVIA_STORAGE_ENDPOINT=

# Supabase server-side account deletion.
AVIA_ACCOUNT_DELETE_PROVIDER=supabase
AVIA_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
AVIA_SUPABASE_SERVICE_ROLE_KEY=SERVER_ONLY_SERVICE_ROLE_KEY

# Public compliance/support URLs used by App Store / Google Play.
AVIA_SUPPORT_EMAIL=support@example.com
AVIA_PUBLIC_BASE_URL=https://api.example.com

# Visual drawing review
HF_TOKEN=

# Web-grounded AV research when enabled
TAVILY_API_KEY=

# Optional observability
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Mobile EAS environment values are configured separately:
# EXPO_PUBLIC_API_URL=https://api.example.com
# EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=PUBLIC_ANON_KEY
