# AV Intelligence Assistant - production API example
AVIA_ENV=production

# Managed PostgreSQL connection string, e.g. Supabase/Render/Railway/Neon.
AVIA_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE

# Production authentication must use JWT.
AVIA_AUTH_MODE=jwt

# Recommended: provider JWKS URL (Supabase/Auth0/Clerk/etc.).
AVIA_JWT_JWKS_URL=https://YOUR-AUTH-PROVIDER/.well-known/jwks.json
AVIA_JWT_ALGORITHMS=RS256,ES256
AVIA_JWT_AUDIENCE=
AVIA_JWT_ISSUER=

# Alternative to JWKS: static verification key.
# AVIA_JWT_PUBLIC_KEY=
# AVIA_JWT_SECRET=

# Comma-separated approved web origins only. Never use * in production.
AVIA_CORS_ORIGINS=https://app.example.com

# Visual drawing review
HF_TOKEN=

# Optional observability
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
